#!/usr/bin/env node
// Customer release acceptance driver for the OpenCode Firewall source archive.
//
// Contract with the shared release-acceptance action: it supplies
// CUSTOMER_ARTIFACT, CUSTOMER_VERSION, CUSTOMER_SOURCE_SHA,
// CUSTOMER_ARTIFACT_SHA256, CUSTOMER_RESULT and CUSTOMER_ARCHIVE_HELPER.
// CUSTOMER_RESULT receives only {"install","native","live"} status strings
// (PASS, FAIL or BLOCKED). Detailed harness output stays in a private
// temporary directory that is removed on exit. Current archives carry the built
// runtime. Historical source distributions follow their documented locked build.
import { spawn } from "node:child_process";
import { createHash } from "node:crypto";
import { createReadStream } from "node:fs";
import { copyFile, cp, mkdir, mkdtemp, readFile, realpath, rename, rm, writeFile } from "node:fs/promises";
import { tmpdir } from "node:os";
import path from "node:path";
import { fileURLToPath } from "node:url";

const reviewedRoot = path.resolve(path.dirname(fileURLToPath(import.meta.url)), "..");

const PACKAGE_NAME = "@silmaril/opencode-firewall-plugin";
const GENERATIONS = [1, 2];
const STEP_TIMEOUT_MS = 20 * 60_000;
const PASSTHROUGH = [
  "PATH", "LANG", "LC_ALL", "CI", "SHELL", "HTTP_PROXY", "HTTPS_PROXY", "NO_PROXY",
  "http_proxy", "https_proxy", "no_proxy", "SSL_CERT_FILE", "NODE_EXTRA_CA_CERTS",
];

const status = { install: "BLOCKED", native: "BLOCKED", live: "BLOCKED" };
const resultPath = process.env.CUSTOMER_RESULT;
if (!resultPath || !path.isAbsolute(resultPath)) {
  console.error("CUSTOMER_RESULT must be an absolute path");
  process.exit(2);
}

async function publish() {
  const temporary = `${resultPath}.${process.pid}.tmp`;
  await writeFile(temporary, `${JSON.stringify(status)}\n`, { mode: 0o600 });
  await rename(temporary, resultPath);
}

function run(command, args, { cwd, env } = {}) {
  return new Promise((resolve) => {
    const child = spawn(command, args, {
      cwd,
      env,
      timeout: STEP_TIMEOUT_MS,
      stdio: ["ignore", "pipe", "pipe"],
    });
    const out = [];
    child.stdout.on("data", (chunk) => out.push(chunk));
    child.stderr.resume();
    child.once("error", () => resolve({ code: 127, stdout: "" }));
    child.once("close", (code) =>
      resolve({ code: code ?? 1, stdout: Buffer.concat(out).toString("utf8") }),
    );
  });
}

async function sha256(file) {
  const hash = createHash("sha256");
  for await (const chunk of createReadStream(file)) hash.update(chunk);
  return hash.digest("hex");
}

class Stop extends Error {
  constructor(message, install) {
    super(message);
    this.install = install;
  }
}

async function stage(env, privateRoot) {
  const { CUSTOMER_ARTIFACT: artifact, CUSTOMER_VERSION: version } = env;
  const sourceSha = env.CUSTOMER_SOURCE_SHA;
  if (
    !path.isAbsolute(artifact ?? "") ||
    !/^(0|[1-9]\d*)\.(0|[1-9]\d*)\.(0|[1-9]\d*)$/u.test(version ?? "") ||
    !/^[0-9a-f]{40}$/u.test(sourceSha ?? "") ||
    !/^[0-9a-f]{64}$/u.test(env.CUSTOMER_ARTIFACT_SHA256 ?? "")
  ) {
    throw new Stop("malformed customer identity", "FAIL");
  }
  const actual = await sha256(artifact).catch(() => undefined);
  if (!actual) throw new Stop("artifact is unreadable", "BLOCKED");
  if (actual !== env.CUSTOMER_ARTIFACT_SHA256) throw new Stop("artifact digest mismatch", "FAIL");

  // git archive records its commit in the tar header when produced by git.
  const archived = await run("python3", [
    "-I", "-c",
    "import sys,tarfile\nwith tarfile.open(sys.argv[1], 'r|gz') as archive:\n print(archive.pax_headers.get('comment', ''))",
    artifact,
  ]);
  const archivedSha = archived.stdout.trim();
  if (archived.code !== 0 || archivedSha !== sourceSha) {
    throw new Stop("archive commit differs from the supplied source SHA", "FAIL");
  }

  const helper = env.CUSTOMER_ARCHIVE_HELPER;
  if (!helper) throw new Stop("CUSTOMER_ARCHIVE_HELPER is not set", "BLOCKED");
  const source = path.join(privateRoot, "source");
  const unpacked = await run("python3", [helper, artifact, source, "--prefix", "source"]);
  if (unpacked.code !== 0) throw new Stop("archive layout rejected", "FAIL");

  const manifest = JSON.parse(await readFile(path.join(source, "package.json"), "utf8").catch(() => "{}"));
  if (manifest.name !== PACKAGE_NAME || manifest.version !== version) {
    throw new Stop("archive package identity differs from the supplied version", "FAIL");
  }
  return source;
}

async function preparePackage(source, root, env) {
  const hasRuntime = async (directory) => {
    const manifest = JSON.parse(await readFile(path.join(directory, "package.json"), "utf8"));
    const files = [manifest.main, ...Object.values(manifest.exports ?? {}).map((entry) => entry.import)];
    if (!files.length || files.some((file) => typeof file !== "string" || !file.startsWith("./dist/") || file.includes(".."))) return false;
    return (await Promise.all(files.map((file) => realpath(path.join(directory, file)).catch(() => undefined))))
      .every((file) => file?.startsWith(path.join(directory, "dist") + path.sep));
  };
  if (await hasRuntime(source)) return source;
  // The published v0.4.9 customer installation builds TypeScript from this source tag.
  if (env.CUSTOMER_VERSION !== "0.4.9" || env.CUSTOMER_SOURCE_SHA !== "3a8b2810f8300dd28e0ff1adffc7de81a0c14b30") {
    throw new Stop("frozen package is missing its declared runtime exports", "FAIL");
  }
  const consumer = path.join(root, "historical-build");
  await cp(source, consumer, { recursive: true });
  const options = { cwd: consumer, env: childEnvironment(root, {}) };
  const dependencies = await run("npm", ["ci", "--ignore-scripts", "--no-audit", "--no-fund"], options);
  if (dependencies.code !== 0) throw new Stop("historical lockfile dependencies unavailable", "BLOCKED");
  const compilation = await run(process.execPath, ["node_modules/typescript/bin/tsc", "-p", "tsconfig.json"], options);
  if (compilation.code !== 0 || !await hasRuntime(consumer)) throw new Stop("documented historical source installation failed", "FAIL");
  return consumer;
}

function childEnvironment(privateRoot, extra) {
  const home = path.join(privateRoot, "home");
  return {
    ...Object.fromEntries(PASSTHROUGH.flatMap((name) => (process.env[name] ? [[name, process.env[name]]] : []))),
    HOME: home,
    TMPDIR: privateRoot,
    npm_config_cache: path.join(home, ".npm"),
    ...extra,
  };
}

// Run the reviewed native harness against the staged customer package and keep only the
// facts needed to report a status.
async function harness(source, privateRoot, hostRoot, generation, live, env) {
  const receiptPath = path.join(privateRoot, `${live ? "live" : "loopback"}-${generation}.json`);
  const credentials = live
    ? {
        CUSTOMER_NATIVE_CLASSIFIER: "live",
        CUSTOMER_NATIVE_API_URL: env.CUSTOMER_NATIVE_API_URL,
        CUSTOMER_NATIVE_API_KEY: env.CUSTOMER_NATIVE_API_KEY,
      }
    : {};
  const finished = await run(
    process.execPath,
    [path.join(reviewedRoot, "scripts/run-native-acceptance.mjs"), "--generation", String(generation)],
    {
      cwd: source,
      env: childEnvironment(privateRoot, {
        ...credentials,
        CUSTOMER_RELEASE_BENIGN_LIVE: "1",
        NATIVE_ACCEPTANCE_PACKAGE_ROOT: source,
        NATIVE_ACCEPTANCE_HOST_ROOT: hostRoot,
        GITHUB_SHA: env.CUSTOMER_SOURCE_SHA,
        NATIVE_ACCEPTANCE_RECEIPT: receiptPath,
      }),
    },
  );
  const receipt = JSON.parse(await readFile(receiptPath, "utf8").catch(() => "null"));
  const reported = receipt?.status;
  if (!["PASS", "FAIL", "BLOCKED"].includes(reported) || (finished.code === 0) !== (reported === "PASS")) {
    return { status: "FAIL", plugin: false };
  }
  const plugin =
    receipt.plugin?.version === env.CUSTOMER_VERSION && receipt.plugin.installed_bytes_match === true;
  const genuine =
    receipt.source_sha === env.CUSTOMER_SOURCE_SHA &&
    receipt.classifier === (live ? "live" : "loopback") &&
    receipt.host?.generation === generation &&
    Array.isArray(receipt.scenarios) &&
    receipt.scenarios.length > 0 &&
    (reported !== "PASS" || receipt.scenarios.every((scenario) => scenario.status === "PASS"));
  for (const scenario of receipt.scenarios ?? []) {
    const failing = Object.entries(scenario.checks ?? {}).filter(([, ok]) => !ok).map(([name]) => name);
    if (scenario.status !== "PASS") {
      console.error(`${live ? "live" : "loopback"} generation ${generation} ${scenario.id}: ${scenario.status} ${scenario.blocker ?? failing.join(",")}`);
    }
  }
  return { status: reported === "PASS" && !genuine ? "FAIL" : reported, plugin };
}

function combine(results) {
  if (results.some(({ status: value }) => value === "FAIL")) return "FAIL";
  return results.every(({ status: value }) => value === "PASS") ? "PASS" : "BLOCKED";
}

async function main() {
  await publish();
  const privateRoot = await realpath(await mkdtemp(path.join(tmpdir(), "opencode-customer-")));
  try {
    const env = process.env;
    const source = await stage(env, privateRoot).then((archive) => preparePackage(archive, privateRoot, env)).catch((error) => {
      if (!(error instanceof Stop)) throw error;
      console.error(error.message);
      status.install = error.install;
      return undefined;
    });
    if (!source) return;
    const hostRoot = path.join(privateRoot, "native-host");
    await mkdir(hostRoot);
    for (const name of ["package.json", "package-lock.json"]) {
      await copyFile(path.join(reviewedRoot, name), path.join(hostRoot, name));
    }
    const bootstrap = await run("npm", ["ci", "--no-audit", "--no-fund"], {
      cwd: hostRoot,
      env: childEnvironment(privateRoot, {}),
    });
    if (bootstrap.code !== 0) {
      console.error("pinned bootstrap (npm ci) failed");
      status.install = "FAIL";
      return;
    }
    if (process.platform === "win32") {
      console.error("native harness does not support Windows hosts");
      status.install = "BLOCKED";
      return;
    }

    const loopback = [];
    for (const generation of GENERATIONS) {
      loopback.push(await harness(source, privateRoot, hostRoot, generation, false, env));
    }
    status.install = loopback.every(({ plugin }) => plugin) ? "PASS" : "FAIL";
    status.native = combine(loopback);
    await publish();

    if (!env.CUSTOMER_NATIVE_API_URL || !env.CUSTOMER_NATIVE_API_KEY) {
      console.error("live acceptance requires CUSTOMER_NATIVE_API_URL and CUSTOMER_NATIVE_API_KEY");
      return;
    }
    const live = [];
    for (const generation of GENERATIONS) {
      live.push(await harness(source, privateRoot, hostRoot, generation, true, env));
    }
    status.live = combine(live);
  } catch (error) {
    console.error(`acceptance aborted: ${error.name}`);
    for (const name of Object.keys(status)) if (status[name] === "PASS") status[name] = "FAIL";
  } finally {
    await rm(privateRoot, { recursive: true, force: true });
    await publish();
  }
}

await main();
process.exitCode = Object.values(status).every((value) => value === "PASS") ? 0 : 1;
