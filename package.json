{
  "name": "@silmaril/opencode-firewall-plugin",
  "version": "0.4.6",
  "description": "Classify opencode parent and child lifecycle events with Silmaril Firewall and render readable native block decisions.",
  "type": "module",
  "private": true,
  "license": "UNLICENSED",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./server": {
      "types": "./dist/server.d.ts",
      "import": "./dist/server.js"
    },
    "./tui": {
      "types": "./dist/tui.d.ts",
      "import": "./dist/tui.js"
    }
  },
  "files": [
    "dist",
    "examples",
    "opencode",
    "scripts/install-opencode-assets.mjs",
    "scripts/open-browser.mjs",
    "scripts/open-browser.d.mts",
    "scripts/open-playground.mjs",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "install:opencode-assets": "node scripts/install-opencode-assets.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && npm run test:unit && npm run test:hosts",
    "test:unit": "node scripts/run-unit-tests.mjs",
    "test:hosts": "bun scripts/run-v1-contract-qualification.mjs && bun scripts/run-host-qualification.mjs",
    "pack:dry": "npm pack --dry-run",
    "prepublishOnly": "node scripts/block-publish.mjs"
  },
  "dependencies": {
    "@silmaril-security/sdk": "0.8.2"
  },
  "peerDependencies": {
    "@opencode-ai/plugin": ">=1.0.0",
    "@opencode/plugin": "2.2.6",
    "effect": "^4.0.0"
  },
  "peerDependenciesMeta": {
    "@opencode-ai/plugin": {
      "optional": true
    },
    "@opencode/plugin": {
      "optional": true
    },
    "effect": {
      "optional": true
    }
  },
  "devDependencies": {
    "@opencode-ai/plugin": "1.19.5",
    "@opencode/cli": "2.2.6",
    "@opencode/core": "2.2.6",
    "@opencode/plugin": "2.2.6",
    "@opencode/util": "2.2.6",
    "@types/node": "^24.0.0",
    "bun": "1.4.4",
    "effect": "4.1.0",
    "esbuild": "^0.28.1",
    "opencode-ai": "1.19.5",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=22"
  }
}
